import React from "react";

const getStatusClass = (status) => {
  switch (status) {
    case "Ready":
      return "sd-status-ready";
    case "Completed":
      return "sd-status-completed";
    case "Preparing":
      return "sd-status-preparing";
    default:
      return "";
  }
};

const RecentOrders = ({ orders }) => {
  return (
    <div className="sd-table-wrapper">
      <table className="sd-orders-table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Item</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {orders.map((order) => (
            <tr key={order.orderId}>
              <td>#{order.orderId}</td>
              <td>{order.item}</td>
              <td>
                <span className={`sd-status-badge ${getStatusClass(order.status)}`}>
                  {order.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

export default RecentOrders;